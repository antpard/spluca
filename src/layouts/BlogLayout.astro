---
import Section from "../components/common/Section.astro";
import type { ArticleFrontmatter } from "../lib/types";
import { processArticleDate, generateSourceUrl } from "../lib/utils";
import { GLOBAL } from "../lib/variables";
import Seo from "../components/Seo.astro";
import { blogPostingSchema, breadcrumbSchema } from "../lib/seo";
import type { MarkdownLayoutProps } from "astro";
import Prose from "../components/Prose.astro";
import TagLink from "../components/TagLink.astro";
import Anchor from "../components/common/Anchor.astro";
import ArticleSnippet from "../components/ArticleSnippet.astro";
import { articles } from "../lib/list";
import Layout from "./Layout.astro";

type Props = MarkdownLayoutProps<ArticleFrontmatter>;

const { frontmatter } = Astro.props;
const articleDate = processArticleDate(frontmatter.timestamp);
const sourceUrl = generateSourceUrl(frontmatter.filename, "blog");
const articleIndex = articles.findIndex((article) => article.filename === sourceUrl);
const previousArticle = articleIndex >= 0 ? articles[articleIndex + 1] : undefined;
const nextArticle = articleIndex > 0 ? articles[articleIndex - 1] : undefined;
const relatedArticles = articles
  .filter((article) => article.filename !== sourceUrl && article.tags?.some((tag) => frontmatter.tags?.includes(tag)))
  .slice(0, 3);
---

<Layout>
  <Fragment slot="head">
    <Seo
      title={`${frontmatter.title} • ${GLOBAL.username}`}
      description={frontmatter.description}
      canonicalPath={`/blog/${frontmatter.filename}`}
      ogType="article"
      publishedTime={frontmatter.timestamp}
      articleSection="Technical articles"
      articleTags={frontmatter.tags}
      jsonLd={[
        blogPostingSchema(frontmatter),
        breadcrumbSchema([
          { name: GLOBAL.username, path: "/" },
          { name: GLOBAL.articlesName, path: "/blog" },
          { name: frontmatter.title, path: sourceUrl },
        ]),
      ]}
    />
  </Fragment>
  <Section class="pt-8">
    <div class="flex flex-col gap-4 mt-8 mb-16">
      <h1
        class="text-3xl sm:text-4xl leading-normal sm:leading-normal font-mono"
      >
        {frontmatter.title}
      </h1>
      <div class="flex justify-between">
        <span>{articleDate}</span>
        <span>{frontmatter.time} min</span>
      </div>
      {frontmatter.tags?.length ? (
        <div class="flex flex-row wrap gap-2">
          {frontmatter.tags.map((tag) => <TagLink tag={tag} />)}
        </div>
      ) : null}
    </div>
    <Prose>
      <slot />
    </Prose>
    {relatedArticles.length > 0 && (
      <section class="mt-16">
        <h2 class="font-mono text-xl sm:text-2xl leading-loose">Related articles</h2>
        <ul class="mt-6">
          {relatedArticles.map((article) => (
            <li>
              <ArticleSnippet
                title={article.title}
                description={article.description}
                url={article.filename}
                duration={`${article.time} min`}
                timestamp={article.timestamp}
              />
            </li>
          ))}
        </ul>
      </section>
    )}
    <div class="flex flex-col gap-4 pt-8">
      <p>~{GLOBAL.username}</p>
      <div class="flex flex-wrap gap-4">
        {previousArticle && <Anchor url={previousArticle.filename}>Previous article</Anchor>}
        {nextArticle && <Anchor url={nextArticle.filename}>Next article</Anchor>}
        <Anchor url="/blog">Back to all articles</Anchor>
        <a class="text-red-400 hover:underline" href="/contact">Discuss a related system</a>
      </div>
    </div>
  </Section>
</Layout>
