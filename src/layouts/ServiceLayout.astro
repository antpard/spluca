---
import { generateSourceUrl } from "../lib/utils";
import type { ServiceFrontmatter } from "../lib/types";
import type { MarkdownLayoutProps } from "astro";
import Prose from "../components/Prose.astro";
import Layout from "./Layout.astro";
import Section from "../components/common/Section.astro";
import { GLOBAL } from "../lib/variables";
import Seo from "../components/Seo.astro";
import { breadcrumbSchema, serviceSchema } from "../lib/seo";
import TagLink from "../components/TagLink.astro";


type Props = MarkdownLayoutProps<ServiceFrontmatter>;

const { frontmatter } = Astro.props;
const sourceUrl = generateSourceUrl(frontmatter.filename, "services");
---

<Layout>
  <Fragment slot="head">
    <Seo
      title={`${frontmatter.title} • ${GLOBAL.username}`}
      description={frontmatter.description}
      canonicalPath={`/services/${frontmatter.filename}`}
      jsonLd={[
        serviceSchema(frontmatter),
        breadcrumbSchema([
          { name: GLOBAL.username, path: "/" },
          { name: GLOBAL.servicesName, path: "/services" },
          { name: frontmatter.title, path: sourceUrl },
        ]),
      ]}
    />
  </Fragment>
  <Section class="mt-8">
    <div class="flex flex-col gap-4 mt-8 mb-16">
      <h1 class="text-3xl sm:text-4xl leading-tight font-display">
        {frontmatter.title}
      </h1>
      <div class="flex text-sm gap-2">
        {
          frontmatter.tags
            ? frontmatter.tags.map((tag) => (
                <TagLink tag={tag} />
              ))
            : null
        }
      </div>
    </div>
    <Prose>
      <slot />
    </Prose>
  </Section>
</Layout>
