---
import { generateSourceUrl } from "../lib/utils";
import type { ProjectFrontmatter } from "../lib/types";
import type { MarkdownLayoutProps } from "astro";
import Prose from "../components/Prose.astro";
import Layout from "./Layout.astro";
import Section from "../components/common/Section.astro";
import Anchor from "../components/common/Anchor.astro";
import { GLOBAL } from "../lib/variables";
import Seo from "../components/Seo.astro";
import { breadcrumbSchema, softwareSourceCodeSchema } from "../lib/seo";
import TagLink from "../components/TagLink.astro";


type Props = MarkdownLayoutProps<ProjectFrontmatter>;

const { frontmatter } = Astro.props;
const sourceUrl = generateSourceUrl(frontmatter.filename, "projects");
---

<Layout>
  <Fragment slot="head">
    <Seo
      title={`${frontmatter.title} • ${GLOBAL.username}`}
      description={frontmatter.description}
      canonicalPath={`/projects/${frontmatter.filename}`}
      jsonLd={[
        softwareSourceCodeSchema(frontmatter),
        breadcrumbSchema([
          { name: GLOBAL.username, path: "/" },
          { name: GLOBAL.projectsName, path: "/projects" },
          { name: frontmatter.title, path: sourceUrl },
        ]),
      ]}
    />
  </Fragment>
  <Section class="mt-8">
    <div class="flex flex-col gap-4 mt-8 mb-16">
      <Anchor url="/projects" class="text-base">All projects</Anchor>
      <h1 class="text-3xl sm:text-4xl leading-tight font-mono">
        {frontmatter.title}
      </h1>
      <p class="text-lg max-w-2xl">{frontmatter.description}</p>
      <div class="flex text-sm gap-2">
        {
          frontmatter.tags
            ? frontmatter.tags.map((tag) => (
                <TagLink tag={tag} />
              ))
            : null
        }
      </div>
      <div class="flex gap-2">
        {
          frontmatter.githubUrl ? (
            <Anchor url={frontmatter.githubUrl} class="text-base" external>
              View repository
            </Anchor>
          ) : null
        }
        {
          frontmatter.liveUrl ? (
            <Anchor url={frontmatter.liveUrl} class="text-base" external>
              Open live product
            </Anchor>
          ) : null
        }
      </div>
    </div>
    <aside class="zag-border-b zag-transition border-t py-6 mb-12">
      <h2 class="font-mono text-xl leading-loose">At a glance</h2>
      <dl class="grid gap-4 mt-4 sm:grid-cols-2">
        <div>
          <dt class="zag-muted zag-transition text-sm uppercase tracking-wide">Project focus</dt>
          <dd class="mt-1">Open-source software infrastructure and systems engineering.</dd>
        </div>
        <div>
          <dt class="zag-muted zag-transition text-sm uppercase tracking-wide">Technical scope</dt>
          <dd class="mt-1">{frontmatter.tags?.join(" · ")}</dd>
        </div>
      </dl>
    </aside>
    <Prose>
      <slot />
    </Prose>
    <div class="mt-12 mb-8">
      <p class="zag-text zag-transition text-lg">
        Working through a similar infrastructure problem? <a class="text-red-400 hover:underline" href="/contact">Contact me to discuss your system</a>.
      </p>
    </div>
  </Section>
</Layout>
