---
import { GLOBAL } from "../../lib/variables";
import Layout from "../../layouts/Layout.astro";
import ArticleSnippet from "../../components/ArticleSnippet.astro";
import Section from "../../components/common/Section.astro";
import { articles } from "../../lib/list";
import Seo from "../../components/Seo.astro";
import { breadcrumbSchema, collectionPageSchema, itemListSchema } from "../../lib/seo";

---

<Layout>
  <Fragment slot="head">
    <Seo
      title={`${GLOBAL.blogTitle} • ${GLOBAL.username}`}
      description={GLOBAL.blogLongDescription}
      canonicalPath="/blog"
      jsonLd={[
        collectionPageSchema({
          name: GLOBAL.blogTitle,
          description: GLOBAL.blogLongDescription,
          path: "/blog",
        }),
        itemListSchema({
          name: GLOBAL.blogTitle,
          path: "/blog",
          items: articles.map(({ title, filename }) => ({
            title,
            filename: filename.replace("/blog/", ""),
          })),
        }),
        breadcrumbSchema([
          { name: GLOBAL.username, path: "/" },
          { name: GLOBAL.articlesName, path: "/blog" },
        ]),
      ]}
    />
  </Fragment>
  <Section class="my-8">
    <div class="flex items-center gap-4 pt-8 pb-16">
      <h1 class="font-mono text-3xl sm:text-4xl leading-loose">{GLOBAL.articlesName}</h1>
    </div>
    <div class="flex flex-col gap-4 mb-12">
      <h2 class="font-mono text-xl sm:text-2xl leading-loose">Featured article</h2>
      <p class="text-lg">Practical notes on designing, operating, and improving complex systems.</p>
    </div>
    <ul>
      {
        articles.map((project) => (
          <li>
            <ArticleSnippet
              title={project.title}
              description={project.description}
              duration={`${project.time} min`}
              url={project.filename}
              timestamp={project.timestamp}
              tags={project.tags}
            />
          </li>
        ))
      }
    </ul>
  </Section>
</Layout>
