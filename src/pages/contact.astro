---
import { GLOBAL } from "../lib/variables";
import Layout from "../layouts/Layout.astro";
import Section from "../components/common/Section.astro";
import Seo from "../components/Seo.astro";
import { breadcrumbSchema, contactPageSchema } from "../lib/seo";

---

<Layout>
  <Fragment slot="head">
    <Seo
      title={`${GLOBAL.contactTitle} • ${GLOBAL.username}`}
      description={GLOBAL.contactLongDescription}
      canonicalPath="/contact"
      jsonLd={[
        contactPageSchema(),
        breadcrumbSchema([
          { name: GLOBAL.username, path: "/" },
          { name: GLOBAL.contactTitle, path: "/contact" },
        ]),
      ]}
    />
  </Fragment>
  <Section class="py-4 my-8">
    <div class="flex items-center gap-4 pt-8 pb-16">
      <h1 class="font-display text-3xl sm:text-4xl leading-loose">{GLOBAL.contactTitle}</h1>
    </div>
    <div class="flex flex-col gap-8">
      <p class="zag-text zag-transition text-lg">
        Interested in discussing my projects, exploring collaboration opportunities, or looking for professional services? I'd love to hear from you. Drop me a line at <a href="mailto:apardo@spluca.org" class="text-emerald-400 hover:underline">apardo@spluca.org</a>  and I'll get back to you as soon as possible.
      </p>
      <p class="zag-text zag-transition text-lg">
        You can also chat with me via WhatsApp or talk on the phone at <a href="https://wa.me/34641653695" class="text-emerald-400 hover:underline">+34 639 463 350</a>.
      </p>
    </div>
  </Section>
</Layout>
