---
import { GLOBAL } from "../lib/variables";
import Layout from "../layouts/Layout.astro";
import Section from "../components/common/Section.astro";

---

<Layout>
  <Fragment slot="head">
    <title>{GLOBAL.contactTitle} • {GLOBAL.username}</title>
    <meta
      name="description"
      content={GLOBAL.contactLongDescription}
    />
    <meta property="og:title" content={`${GLOBAL.contactTitle} • ${GLOBAL.username}`} />
    <meta
      property="og:description"
      content={GLOBAL.contactShortDescription}
    />
    <meta property="og:image" content={`${GLOBAL.rootUrl}/${GLOBAL.profileImage}`} />
    <meta property="og:url" content={`${GLOBAL.rootUrl}/contact`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${GLOBAL.contactTitle} • ${GLOBAL.username}`} />
    <meta
      name="twitter:description"
      content={GLOBAL.contactShortDescription}
    />
    <meta name="twitter:image" content={`${GLOBAL.rootUrl}/${GLOBAL.profileImage}`} />
    <meta http-equiv="content-language" content="en" />
    <meta name="language" content="English" />
    <link rel="canonical" href={`${GLOBAL.rootUrl}/contact`} />
  </Fragment>
  <Section class="py-4 my-8">
    <div class="flex items-center gap-4 pt-8 pb-16">
      <h1 class="font-display text-3xl sm:text-4xl leading-loose">{GLOBAL.contactTitle}</h1>
    </div>
    <div class="flex flex-col gap-8">
      <p class="zag-text zag-transition text-lg">
        Interested in discussing my projects, exploring collaboration opportunities, or looking for professional services? I'd love to hear from you. Drop me a line at
        <a href="mailto:apardo@spluca.org" class="text-emerald-400 hover:underline">apardo@spluca.org</a>
        and I'll get back to you as soon as possible.
      </p>
      <p class="zag-text zag-transition text-lg">
        You can also chat with me via WhatsApp or talk on the phone at
        <a href="https://wa.me/34641653695" class="text-emerald-400 hover:underline">+34 641 653 695</a>.
      </p>
    </div>
  </Section>
</Layout>
