---
import { projects } from "../../lib/list";
import Section from "../../components/common/Section.astro";
import ProjectSnippet from "../../components/ProjectSnippet.astro";
import Layout from "../../layouts/Layout.astro";
import { GLOBAL } from "../../lib/variables";
import Seo from "../../components/Seo.astro";
import { breadcrumbSchema, collectionPageSchema, itemListSchema } from "../../lib/seo";
---

<Layout>
  <Fragment slot="head">
    <Seo
      title={`${GLOBAL.projectTitle} • ${GLOBAL.username}`}
      description={GLOBAL.projectLongDescription}
      canonicalPath="/projects"
      jsonLd={[
        collectionPageSchema({
          name: GLOBAL.projectTitle,
          description: GLOBAL.projectLongDescription,
          path: "/projects",
        }),
        itemListSchema({
          name: GLOBAL.projectTitle,
          path: "/projects",
          items: projects.map(({ title, filename }) => ({
            title,
            filename: filename.replace("/projects/", ""),
          })),
        }),
        breadcrumbSchema([
          { name: GLOBAL.username, path: "/" },
          { name: GLOBAL.projectsName, path: "/projects" },
        ]),
      ]}
    />
  </Fragment>
  <Section class="py-4 my-8">
    <div class="flex items-center gap-4 pt-8 pb-16">
      <h1 class="font-display text-3xl sm:text-4xl leading-loose">{GLOBAL.projectsName}</h1>
    </div>
    <div class="flex flex-col gap-4 mb-12">
      <h2 class="font-display text-xl sm:text-2xl leading-loose">Selected projects</h2>
      <p class="text-lg">Infrastructure products and systems built with reliability, clear interfaces, and practical operations in mind.</p>
    </div>
    <ul>
      {
        projects.map((project) => (
          <li>
            <ProjectSnippet
              title={project.title}
              description={project.description}
              url={project.filename}
              githubUrl={project.githubUrl}
              liveUrl={project.liveUrl}
              tags={project.tags ?? []}
            />
          </li>
        ))
      }
    </ul>
  </Section>
</Layout>
