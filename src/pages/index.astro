---
import { featuredArticles, featuredProjects, featuredServices } from "../lib/featured";
import { GLOBAL } from "../lib/variables";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/home/Hero.astro";
import Section from "../components/common/Section.astro";
import FeaturedProjects from "../components/home/FeaturedProjects.astro";
import FeaturedServices from "../components/home/FeaturedServices.astro";
import FeaturedArticles from "../components/home/FeaturedArticles.astro";
import Anchor from "../components/common/Anchor.astro";
import Seo from "../components/Seo.astro";
import { personSchema, websiteSchema } from "../lib/seo";
---

<Layout>
  <Fragment slot="head">
    <Seo
      title={`${GLOBAL.username} • ${GLOBAL.shortDescription}`}
      description={GLOBAL.longDescription}
      canonicalPath="/"
      image="spluca.png"
      jsonLd={[personSchema(), websiteSchema()]}
    />
  </Fragment>
  <Section class="my-16">
    <Hero />
  </Section>
  <Section>
    <FeaturedServices featuredServices={featuredServices} />
  </Section>
  <Section>
    <FeaturedProjects featuredProjects={featuredProjects} />
  </Section>
  <Section>
    <FeaturedArticles featuredArticles={featuredArticles} />
  </Section>
  <Section class="my-16">
    <div class="zag-border-b zag-transition border-t py-8 flex flex-col gap-4">
      <h2 class="font-display text-xl sm:text-2xl leading-loose">Have a difficult system to solve?</h2>
      <p>Share the constraints and context. We can identify the highest-value next step together.</p>
      <Anchor url="/contact" class="zag-cta-primary w-fit">Discuss your system</Anchor>
    </div>
  </Section>
</Layout>
