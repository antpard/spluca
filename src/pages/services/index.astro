---
import { services } from "../../lib/list";
import Section from "../../components/common/Section.astro";
import ServiceSnippet from "../../components/ServiceSnippet.astro";
import Layout from "../../layouts/Layout.astro";
import { GLOBAL } from "../../lib/variables";
import Seo from "../../components/Seo.astro";
import { breadcrumbSchema, collectionPageSchema } from "../../lib/seo";
---

<Layout>
  <Fragment slot="head">
    <Seo
      title={`${GLOBAL.serviceTitle} • ${GLOBAL.username}`}
      description={GLOBAL.serviceLongDescription}
      canonicalPath="/services"
      jsonLd={[
        collectionPageSchema({
          name: GLOBAL.serviceTitle,
          description: GLOBAL.serviceLongDescription,
          path: "/services",
        }),
        breadcrumbSchema([
          { name: GLOBAL.username, path: "/" },
          { name: GLOBAL.servicesName, path: "/services" },
        ]),
      ]}
    />
  </Fragment>
  <Section class="py-4 my-8">
    <div class="flex items-center gap-4 pt-8 pb-16">
      <h1 class="font-display text-3xl sm:text-4xl leading-loose">{GLOBAL.servicesName}</h1>
    </div>
    <ul>
      {
        services.map((service) => (
          <li>
            <ServiceSnippet
              title={service.title}
              description={service.description}
              url={service.filename}
              tags={service.tags ?? []}
            />
          </li>
        ))
      }
    </ul>
  </Section>
</Layout>
