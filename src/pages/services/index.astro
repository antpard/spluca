---
import { services } from "../../lib/list";
import Section from "../../components/common/Section.astro";
import ServiceSnippet from "../../components/ServiceSnippet.astro";
import Layout from "../../layouts/Layout.astro";
import { GLOBAL } from "../../lib/variables";
import Seo from "../../components/Seo.astro";
import { breadcrumbSchema, collectionPageSchema, faqPageSchema, itemListSchema } from "../../lib/seo";
---

<Layout>
  <Fragment slot="head">
    <Seo
      title={`${GLOBAL.serviceTitle} • ${GLOBAL.username}`}
      description={GLOBAL.serviceLongDescription}
      canonicalPath="/services"
      jsonLd={[
        collectionPageSchema({
          name: GLOBAL.serviceTitle,
          description: GLOBAL.serviceLongDescription,
          path: "/services",
        }),
        itemListSchema({
          path: "/services",
          items: services.map(({ title, filename }) => ({ title, filename: filename.replace("/services/", "") })),
        }),
        faqPageSchema([
          {
            question: "Do you work with international teams?",
            answer: "Yes. I work remotely with international teams on cloud infrastructure, backend systems, Linux, Kubernetes, and platform engineering projects.",
          },
          {
            question: "Can you work with an existing production platform?",
            answer: "Yes. I can assess an existing platform, identify operational risks, and implement focused improvements without requiring a full rewrite.",
          },
          {
            question: "How do we start a project?",
            answer: "Start by sharing your goals, constraints, and current challenges through the contact page. We can then define a focused discovery or implementation engagement.",
          },
        ]),
        breadcrumbSchema([
          { name: GLOBAL.username, path: "/" },
          { name: GLOBAL.servicesName, path: "/services" },
        ]),
      ]}
    />
  </Fragment>
  <Section class="py-4 my-8">
    <div class="flex items-center gap-4 pt-8 pb-16">
      <h1 class="font-display text-3xl sm:text-4xl leading-loose">Cloud, Backend &amp; Linux Engineering Services</h1>
    </div>
    <div class="flex flex-col gap-6 mb-16">
      <p class="zag-text zag-transition text-lg">
        I help international teams design, build, and operate reliable software infrastructure remotely — from cloud architecture and Kubernetes platforms to backend systems and hardened Linux servers.
      </p>
      <p class="zag-text zag-transition">
        Explore the services below, or <a class="text-red-400 hover:underline" href="/contact">contact me to discuss your project</a>.
      </p>
    </div>
    <div class="flex flex-col gap-6 mb-16">
      <h2 class="font-display text-xl sm:text-2xl leading-loose">Why work with me</h2>
      <ul class="list-disc pl-6 flex flex-col gap-3">
        <li>Nearly 25 years of experience across cloud infrastructure, Linux systems, backend engineering, and platform architecture.</li>
        <li>End-to-end support from requirements and architecture through implementation, testing, observability, and handoff.</li>
        <li>Practical experience with Kubernetes, Rust, Go, Ruby, Terraform, Docker, and microVM-based systems.</li>
        <li>Remote collaboration for international teams that need reliable, secure, and maintainable production systems.</li>
      </ul>
      <p class="zag-text zag-transition">
        <a class="text-red-400 hover:underline" href="/projects">Explore projects and code</a>
        <span> or </span>
        <a class="text-red-400 hover:underline" href="/blog">read technical articles</a>
        <span> to see how I approach complex systems.</span>
      </p>
    </div>
    <div class="flex flex-col gap-6 mb-16">
      <h2 class="font-display text-xl sm:text-2xl leading-loose">Frequently asked questions</h2>
      <dl class="flex flex-col gap-6">
        <div>
          <dt class="font-semibold">Do you work with international teams?</dt>
          <dd class="mt-2">Yes. I work remotely with international teams on cloud infrastructure, backend systems, Linux, Kubernetes, and platform engineering projects.</dd>
        </div>
        <div>
          <dt class="font-semibold">Can you work with an existing production platform?</dt>
          <dd class="mt-2">Yes. I can assess an existing platform, identify operational risks, and implement focused improvements without requiring a full rewrite.</dd>
        </div>
        <div>
          <dt class="font-semibold">How do we start a project?</dt>
          <dd class="mt-2">Start by sharing your goals, constraints, and current challenges through the <a class="text-red-400 hover:underline" href="/contact">contact page</a>.</dd>
        </div>
      </dl>
    </div>
    <ul>
      {
        services.map((service) => (
          <li>
            <ServiceSnippet
              title={service.title}
              description={service.description}
              url={service.filename}
              tags={service.tags ?? []}
            />
          </li>
        ))
      }
    </ul>
  </Section>
</Layout>
