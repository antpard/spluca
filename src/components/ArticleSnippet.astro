---
import { processArticleDate } from "../lib/utils";
import Anchor from "./common/Anchor.astro";
import TagLink from "./TagLink.astro";

export type Props = {
  title: string;
  description: string;
  url: string;
  duration?: string;
  timestamp?: string;
  tags?: string[];
  featured?: boolean;
};

const { title, description, url, duration, timestamp, tags, featured = false } = Astro.props;
---

<div class:list={["zag-text zag-transition flex flex-col gap-3 pb-8", featured && "zag-featured-item"]}>
  <Anchor url={url} class="text-xl">
    {title}
  </Anchor>
  <p class="">
    {description}
  </p>
  {tags?.length ? (
    <div class="flex flex-row wrap gap-2">
      {tags.map((tag) => <TagLink tag={tag} />)}
    </div>
  ) : null}
  <div
    class="zag-muted zag-transition flex justify-between items-center"
  >
    {timestamp ? <p>{processArticleDate(timestamp)}</p> : null}
    {duration ? <p>{duration}</p> : null}
  </div>
</div>
