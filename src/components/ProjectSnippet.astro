---
import Anchor from "./common/Anchor.astro";
import TagLink from "./TagLink.astro";

export type Props = {
  title: string;
  description: string;
  url: string;
  githubUrl?: string;
  liveUrl?: string;
  tags: string[];
  featured?: boolean;
};

const { title, description, url, githubUrl, liveUrl, tags, featured = false } = Astro.props;
---

<div class:list={["flex flex-col gap-3 pb-8", featured && "zag-featured-item"]}>
  <div class="flex flex-col gap-3 sm:flex-row sm:justify-between">
    <Anchor url={url} class="text-xl">
      {title}
    </Anchor>
    <div class="flex gap-2">
      {
        githubUrl ? (
          <Anchor url={githubUrl} class="text-base" external>
            View repository
          </Anchor>
        ) : null
      }
      {
        liveUrl ? (
          <Anchor url={liveUrl} class="text-base" external>
            Open live product
          </Anchor>
        ) : null
      }
    </div>
  </div>
  <p class="zag-text zag-transition">
    {description}
  </p>
  <div class="flex flex-row wrap gap-2">
    {
      tags.map((tag) => (
        <TagLink tag={tag} />
      ))
    }
  </div>
</div>
