---
import Anchor from "./common/Anchor.astro";
import { slugifyTag } from "../lib/tags";

export type Props = {
  tag: string;
};

const { tag } = Astro.props;
const label = tag.trim();
const slug = slugifyTag(label);
---

{slug ? (
  <Anchor url={`/tags/${slug}`} class="inline-block -zag-text -zag-bg zag-transition px-2 py-1 text-sm font-semibold">
    {label}
  </Anchor>
) : null}
