---
import type { ServiceFrontmatter } from "../../lib/types";
import { GLOBAL } from "../../lib/variables";
import Anchor from "../common/Anchor.astro";
import ServiceSnippet from "../ServiceSnippet.astro";

type Props = {
  featuredServices: Array<ServiceFrontmatter>;
}

const { featuredServices } = Astro.props;
---

<div class="flex justify-between items-center w-full">
  <h3 class="font-display text-lg sm:text-xl leading-loose">{GLOBAL.servicesName}</h3>
  <Anchor url="/services" class="text-base">{GLOBAL.viewAll}</Anchor>
</div>
<ul class="my-8">
  {
    (featuredServices.length === 0 && <p>{GLOBAL.noServices}</p>) ||
      featuredServices.map((service) => (
        <li>
          <ServiceSnippet
            title={service.title}
            description={service.description}
            url={service.filename}
            tags={service.tags ?? []}
          />
        </li>
      ))
  }
</ul>
