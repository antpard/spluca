---
import type { ProjectFrontmatter } from "../../lib/types";
import { GLOBAL } from "../../lib/variables";
import Anchor from "../common/Anchor.astro";
import ProjectSnippet from "../ProjectSnippet.astro";

type Props = {
  featuredProjects: Array<ProjectFrontmatter>;
}

const { featuredProjects } = Astro.props;
---

<div class="flex justify-between items-center w-full">
  <h3 class="font-mono text-lg sm:text-xl leading-loose">{GLOBAL.projectsName}</h3>
  <Anchor url="/projects" class="text-base">{GLOBAL.viewAll}</Anchor>
</div>
<p class="zag-muted zag-transition mt-3 max-w-2xl">
  Systems and products built around reliable infrastructure, clear interfaces, and practical operations.
</p>
<ul class="my-8">
  {
    featuredProjects.length === 0 ? <p>{GLOBAL.noProjects}</p> : (
      <>
        <li>
          <ProjectSnippet
            title={featuredProjects[0].title}
            description={featuredProjects[0].description}
            url={featuredProjects[0].filename}
            githubUrl={featuredProjects[0].githubUrl}
            liveUrl={featuredProjects[0].liveUrl}
            tags={featuredProjects[0].tags ?? []}
            featured
          />
        </li>
        {featuredProjects.slice(1, 3).map((project) => (
          <li>
            <ProjectSnippet
              title={project.title}
              description={project.description}
              url={project.filename}
              githubUrl={project.githubUrl}
              liveUrl={project.liveUrl}
              tags={project.tags ?? []}
            />
          </li>
        ))}
      </>
    )
  }
</ul>
