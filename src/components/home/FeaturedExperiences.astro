---
import type { ExperienceFrontmatter } from "../../lib/types";
import { GLOBAL } from "../../lib/variables";
import Anchor from "../common/Anchor.astro";
import ExperienceSnippet from "../ExperienceSnippet.astro";

type Props = {
  featuredExperiences: Array<ExperienceFrontmatter>;
}

const { featuredExperiences } = Astro.props;
---

<div class="flex justify-between items-center w-full">
  <h3 class="font-display text-lg sm:text-xl leading-loose">{GLOBAL.experiencesName}</h3>
  <Anchor url="/resume" class="text-base">{GLOBAL.viewAll}</Anchor>
</div>
<ul class="my-8">
  {
    (featuredProjects.length === 0 && <p>{GLOBAL.noExperiences}</p>) ||
      featuredExperiences.map((project) => (
        <li>
          <ExperienceSnippet
            title={experience.title}
            description={experience.description}
            url={experience.filename}
            githubUrl={experience.githubUrl}
            liveUrl={experience.liveUrl}
            tags={experience.tags ?? []}
          />
        </li>
      ))
  }
</ul>
