---
import { GLOBAL } from "../lib/variables";
import Anchor from "./common/Anchor.astro";
import ThemeToggle from "./ThemeToggle.astro";

const isActive = (url: string) => Astro.url.pathname === url || (url !== "/" && Astro.url.pathname.startsWith(`${url}/`));
const navigationEntries = Object.entries(GLOBAL.menu).filter(([label]) => label !== "home" && label !== "contact");
---

<header
  class="zag-bg zag-border-b zag-transition sticky top-0 w-full z-10"
>
  <div
    class="zag-bg zag-transition sm:hidden relative z-50 py-4 flex items-center"
  >
    <button
      class="px-4 min-h-11 min-w-11"
      type="button"
      aria-label="Toggle navigation menu"
      aria-controls="primary-navigation"
      aria-expanded="false"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="32"
        height="32"
        viewBox="0 0 512 512"
        class="zag-fill zag-transition"
      >
        <path d="M80 96h352v32H80zm0 144h352v32H80zm0 144h352v32H80z"></path>
      </svg>
    </button>
  </div>
  <nav
    id="primary-navigation"
    class="zag-bg zag-border-b zag-transition fixed sm:relative inset-x-0 top-0 h-auto sm:px-4 flex justify-between flex-col gap-8 py-4 text-xl sm:flex-row max-w-3xl mx-auto sm:pt-4 sm:border-none -translate-y-full sm:translate-y-0"
  >
    <div
      class="flex flex-col font-mono font-medium gap-4 sm:flex-row px-4 sm:px-0 mt-16 sm:mt-0"
    >
      <Anchor url="/" class="font-display text-base">SPLUCA</Anchor>
      {navigationEntries.map(([label, url]) => (
        <Anchor url={url} class={isActive(url) ? "zag-nav-active" : undefined} aria-current={isActive(url) ? "page" : undefined}>{label}</Anchor>
      ))}
    </div>
    <div class="flex gap-4 justify-between px-4 sm:px-0">
        <Anchor url="/contact" class="zag-cta-primary text-base" aria-current={isActive("/contact") ? "page" : undefined}>Contact</Anchor>
        <Anchor url="https://spluca.org/rss.xml" aria-label="RSS Feed">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="32"
            height="32"
            viewBox="0 0 24 24"
          >
            <path
              class="zag-fill zag-transition"
              d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20C4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27zm0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93z"
            ></path>
          </svg>
        </Anchor>
        <ThemeToggle />
        {GLOBAL.twitterProfile && (<Anchor url={GLOBAL.twitterProfile} aria-label="Twitter Profile">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="32"
            height="32"
            viewBox="0 0 24 24"
          >
            <path
              class="zag-fill zag-transition"
              d="m17.687 3.063l-4.996 5.711l-4.32-5.711H2.112l7.477 9.776l-7.086 8.099h3.034l5.469-6.25l4.78 6.25h6.102l-7.794-10.304l6.625-7.571zm-1.064 16.06L5.654 4.782h1.803l10.846 14.34z"
            ></path>
          </svg>
      </Anchor>)}
    </div>
  </nav>
</header>

<script>
  const button = document.querySelector("header button");
  const nav = document.querySelector("nav");
  const menuLinks = nav?.querySelectorAll("a");
  const menuButton = button;
  let isOpen = false;

  function updateNavState() {
    const isMobile = window.matchMedia("(max-width: 640px)").matches;
    if (!isMobile) {
      isOpen = false;
    }
    nav?.classList.toggle("-translate-y-full", isMobile && !isOpen);
    menuButton?.setAttribute("aria-expanded", String(isMobile && isOpen));
  }

  function toggleNav() {
    isOpen = !isOpen;
    updateNavState();
  }

  button?.addEventListener("click", toggleNav);
  menuLinks?.forEach((link) => link.addEventListener("click", () => {
    isOpen = false;
    updateNavState();
  }));
  window.addEventListener("resize", updateNavState);
  updateNavState();

</script>
