---
import {
  absoluteUrl,
  DEFAULT_SOCIAL_IMAGE,
  imageUrl,
  SITE_LANGUAGE,
  type JsonLd,
} from "../lib/seo";
import { GLOBAL } from "../lib/variables";

type Props = {
  title: string;
  description: string;
  canonicalPath?: string;
  image?: string;
  ogType?: "website" | "article" | "profile";
  jsonLd?: JsonLd | JsonLd[];
  publishedTime?: string;
  noindex?: boolean;
};

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  image = DEFAULT_SOCIAL_IMAGE,
  ogType = "website",
  jsonLd = [],
  publishedTime,
  noindex = false,
} = Astro.props;

const canonicalUrl = absoluteUrl(canonicalPath);
const socialImage = imageUrl(image);
const structuredData = Array.isArray(jsonLd) ? jsonLd : [jsonLd];

// Known dimensions for the default social card (public/spluca.png)
const defaultImageSize =
  image === DEFAULT_SOCIAL_IMAGE ? { width: 1342, height: 626 } : null;
---

<title>{title}</title>
<meta name="description" content={description} />
<meta
  name="robots"
  content={noindex ? "noindex, nofollow" : "index, follow"}
/>
<meta http-equiv="content-language" content={SITE_LANGUAGE} />
<meta name="language" content="English" />
<link rel="canonical" href={canonicalUrl} />
<meta property="og:site_name" content={GLOBAL.username} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:alt" content={title} />
{defaultImageSize && (
  <>
    <meta property="og:image:width" content={String(defaultImageSize.width)} />
    <meta property="og:image:height" content={String(defaultImageSize.height)} />
  </>
)}
<meta property="og:url" content={canonicalUrl} />
<meta property="og:type" content={ogType} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content={title} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{structuredData.map((data) => (
  <script type="application/ld+json" set:html={JSON.stringify(data)} />
))}
